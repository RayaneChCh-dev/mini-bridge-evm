{
  "name": "mini-bridge-evm",
  "version": "1.0.0",
  "description": "Mini-bridge mint & burn d'un ERC20 entre deux testnets EVM (Sepolia ↔ Base Sepolia)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "wallets": "node scripts/generate-wallets.js",
    "deploy:sepolia": "INITIAL_SUPPLY=1000000 PEER_CHAIN_IDS=84532 hardhat run scripts/deploy.js --network sepolia",
    "deploy:base-sepolia": "PEER_CHAIN_IDS=11155111 hardhat run scripts/deploy.js --network baseSepolia",
    "test:relayer": "hardhat compile --quiet && node --test relayer/test/*.test.js",
    "relayer": "node relayer/index.js",
    "relayer:status": "node relayer/index.js --status",
    "balances": "node scripts/fund.js",
    "bridge": "node scripts/bridge.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "better-sqlite3": "^11.7.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.29.1"
  },
  "private": true
}
